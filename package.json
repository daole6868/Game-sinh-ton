{
  "name": "suong-do",
  "private": true,
  "version": "0.1.0",
  "description": "Sương Đỏ — game sinh tồn vô hạn nhiều người chơi trên trình duyệt",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @suongdo/server",
    "dev:client": "npm run dev -w @suongdo/client",
    "build": "npm run build -w @suongdo/client",
    "start": "npm run start -w @suongdo/server",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/client",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"packages/shared/test/*.test.ts\" \"apps/server/test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
